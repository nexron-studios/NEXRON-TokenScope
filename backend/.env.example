# Kopie als backend/.env ablegen und anpassen. Die Datei ist gitignored.
# Keine Tokens hier eintragen - die werden bei jedem Poll aus den
# CLI-Dateien gelesen.

# --- Server ---------------------------------------------------------------
# Nur Loopback. Ein anderer Wert macht die Tokens im Netz nutzbar.
AIUSAGE_HOST=127.0.0.1
AIUSAGE_PORT=8787

# --- Polling --------------------------------------------------------------
AIUSAGE_POLL_INTERVAL_SECONDS=60
AIUSAGE_REQUEST_TIMEOUT_SECONDS=10

# UI ohne Credentials entwickeln (klar als Demo gekennzeichnet).
AIUSAGE_DEMO_MODE=0

# Wie lange ein Anbieter hoechstens mit dem letzten guten Wert ueberbrueckt
# wird ("Gehalten"). Danach zeigt die Kachel lieber nichts als etwas Falsches.
AIUSAGE_MAX_BRIDGE_MINUTES=30

# --- Quellen --------------------------------------------------------------
# AIUSAGE_CLAUDE_CREDENTIALS_PATH=/home/pi/.claude/.credentials.json
# AIUSAGE_CLAUDE_PROJECTS_DIR=/home/pi/.claude/projects
# AIUSAGE_CODEX_AUTH_PATH=/home/pi/.codex/auth.json
# AIUSAGE_CODEX_SESSIONS_DIR=/home/pi/.codex/sessions

# Undokumentierte Endpunkte - hier nachziehbar, falls sie sich aendern.
# AIUSAGE_CLAUDE_USAGE_URL=https://api.anthropic.com/api/oauth/usage
# AIUSAGE_CODEX_USAGE_URL=https://chatgpt.com/backend-api/codex/usage

# Zuletzt in den Rollout-Logs gemeldete rate_limits als Rueckfallebene.
AIUSAGE_CODEX_LOG_FALLBACK=1
# Zweiter Notnagel ueber `npx codex-check --json` (braucht Node).
AIUSAGE_CODEX_CLI_FALLBACK=0

# --- Historie -------------------------------------------------------------
AIUSAGE_HISTORY_ENABLED=1
AIUSAGE_HISTORY_RETENTION_DAYS=90
