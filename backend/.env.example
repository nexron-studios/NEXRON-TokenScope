# Kopie als backend/.env ablegen und anpassen. Die Datei ist gitignored.
# Keine Tokens hier eintragen - die werden bei jedem Poll aus den
# CLI-Dateien gelesen.

# --- Server ---------------------------------------------------------------
# Nur Loopback. Ein anderer Wert macht die Tokens im Netz nutzbar.
NEXRON_TOKENSCOPE_HOST=127.0.0.1
NEXRON_TOKENSCOPE_PORT=8787

# --- Polling --------------------------------------------------------------
NEXRON_TOKENSCOPE_POLL_INTERVAL_SECONDS=60
NEXRON_TOKENSCOPE_REQUEST_TIMEOUT_SECONDS=10

# UI ohne Credentials entwickeln (klar als Demo gekennzeichnet).
NEXRON_TOKENSCOPE_DEMO_MODE=0

# Wie lange ein Anbieter hoechstens mit dem letzten guten Wert ueberbrueckt
# wird ("Gehalten"). Danach zeigt die Kachel lieber nichts als etwas Falsches.
NEXRON_TOKENSCOPE_MAX_BRIDGE_MINUTES=30

# --- Quellen --------------------------------------------------------------
# NEXRON_TOKENSCOPE_CLAUDE_CREDENTIALS_PATH=/home/pi/.claude/.credentials.json
# NEXRON_TOKENSCOPE_CLAUDE_PROJECTS_DIR=/home/pi/.claude/projects
# NEXRON_TOKENSCOPE_CODEX_AUTH_PATH=/home/pi/.codex/auth.json
# NEXRON_TOKENSCOPE_CODEX_SESSIONS_DIR=/home/pi/.codex/sessions

# Undokumentierte Endpunkte - hier nachziehbar, falls sie sich aendern.
# NEXRON_TOKENSCOPE_CLAUDE_USAGE_URL=https://api.anthropic.com/api/oauth/usage
# NEXRON_TOKENSCOPE_CODEX_USAGE_URL=https://chatgpt.com/backend-api/codex/usage

# Zuletzt in den Rollout-Logs gemeldete rate_limits als Rueckfallebene.
NEXRON_TOKENSCOPE_CODEX_LOG_FALLBACK=1
# Zweiter Notnagel ueber `npx codex-check --json` (braucht Node).
NEXRON_TOKENSCOPE_CODEX_CLI_FALLBACK=0

# --- Token-Erneuerung -----------------------------------------------------
# Ein abgelaufener Token wird nie selbst erneuert; angestossen wird die CLI,
# die ihn ausgestellt hat. Leere Liste schaltet es ab.
# NEXRON_TOKENSCOPE_CLAUDE_CLI_REFRESH_COMMAND=["claude","auth","status"]
# Fuer Codex bewusst leer, solange ungeklaert ist, ob die Konsole dort erneuert.
# NEXRON_TOKENSCOPE_CODEX_CLI_REFRESH_COMMAND=[]
# NEXRON_TOKENSCOPE_CLI_REFRESH_MIN_INTERVAL_SECONDS=300

# --- Historie -------------------------------------------------------------
NEXRON_TOKENSCOPE_HISTORY_ENABLED=1
NEXRON_TOKENSCOPE_HISTORY_RETENTION_DAYS=90
